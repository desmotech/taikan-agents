# Reference only. Nothing is read from this file. Every value is a Railway
# service Variable, set by scripts/bootstrap.sh (secrets are typed at a prompt).
# The fork's entrypoint copies the ones it knows into ${HERMES_HOME}/.env on
# every boot; the rest stay in the process environment, which Hermes also reads.

# --- every bot ---
BOT=eng                         # picks souls/$BOT.md and config/$BOT.yaml
HERMES_GIT_REF=v2026.8.27       # pinned Hermes tag; bump to upgrade, never `hermes update`
HERMES_HOME=/data/.hermes
HOME=/data
TZ=Asia/Jerusalem
ANTHROPIC_API_KEY=
GATEWAY_ALLOW_ALL_USERS=false

# --- Slack: every bot ---
SLACK_BOT_TOKEN=                # one bot per agent; never paste into chat/Git
SLACK_APP_TOKEN=                # same Slack app, Socket Mode, connections:write
SLACK_ALLOWED_USERS=            # Saar's Slack member id (not display name)
SLACK_HOME_CHANNEL=             # owner DM conversation or private engineering channel id
SLACK_ALLOW_ALL_USERS=false

# --- eng ---
SENTRY_AUTH_TOKEN=
LINEAR_API_KEY=
GITHUB_TOKEN=                   # read-only PAT: actions:read, contents:read
# PostHog key is listed under eng + analyst below.
# Railway for eng uses MCP OAuth, persisted under HERMES_HOME/mcp-tokens/.
# RAILWAY_API_TOKEN below belongs to ops, not eng's remote MCP.

# --- ops ---
RAILWAY_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=                    # https://<account>.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=

# --- eng + analyst ---
POSTHOG_API_KEY=                # personal API key with read scopes

# --- release ---
# This bot must not receive any variables from the eng/ops/analyst sections.
TAIKAN_RELEASE_API_URL=https://api.taikan.fit
TAIKAN_RELEASE_ASSISTANT_TOKEN= # opaque backend token scoped to read/preflight/nudge
